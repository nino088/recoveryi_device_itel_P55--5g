#<src>                         <mnt_point>   <type>  <mnt_flags and options>                              <fs_mgr_flags>
/dev/block/by-name/metadata 	/metadata		ext4		noatime,nosuid,nodev,discard														wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata 	/data 			f2fs		noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt				wait,check,formattable,quota,latemount,resize,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/userdata 	/data 			ext4		noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt				wait,check,formattable,quota,latemount,resize,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/misc         /misc		  	emmc		defaults	                                              defaults
/dev/block/by-name/tranfs       /cache			ext4		noatime,nosuid,nodev,discard	                          wait,check,formattable

# Core Partition
