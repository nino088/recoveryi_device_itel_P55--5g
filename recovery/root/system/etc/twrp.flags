# mount point   fstype            device             device2                 flags
/boot            emmc    /dev/block/by-name/boot               flags=backup=1;display="Boot";flashimg=1;slotselect
/dtbo            emmc    /dev/block/by-name/dtbo               flags=backup=1;display="Dtbo";flashimg=1;slotselect
/boot_para       emmc    /dev/block/by-name/boot_para
/init_boot       emmc    /dev/block/by-name/init_boot          flags=slotselect
/vendor_boot     emmc    /dev/block/by-name/vendor_boot        flags=display="Vendor Boot";flashimg=1;backup=1;slotselect

# AVB partition
/vbmeta          emmc    /dev/block/by-name/vbmeta             flags=display="Vbmeta";flashimg=1;backup=1;slotselect
/vbmeta_system   emmc    /dev/block/by-name/vbmeta_system      flags=backup=1;display="Vbmeta_system";flashimg=1;slotselect
/vbmeta_vendor   emmc    /dev/block/by-name/vbmeta_vendor      flags=backup=1;display="Vbmeta_vendor";flashimg=1;slotselect

# MediaTek partition (IMEI and MODEM)
/protect_f       emmc    /dev/block/by-name/protect1           flags=backup=1;display="protect_f"
/protect_s       emmc    /dev/block/by-name/protect2           flags=backup=1:display="protect_s"
/nvdata          emmc    /dev/block/by-name/nvdata             flags=backup=1;display="nvdata"
/nvram           emmc    /dev/block/by-name/nvram              flags=backup=1;display="nvram"
/nvcfg           emmc    /dev/block/by-name/nvcfg              flags=backup=1;display="nvcfg"
/proinfo         emmc    /dev/block/by-name/proinfo            flags=backup=1;display="proinfo"
/flashinfo       emmc    /dev/block/by-name/flashinfo

# Other
/persistent      emmc    /dev/block/by-name/frp
/persist         ext4    /dev/block/by-name/persist            flags=backup=1;display="Persist"

# Bootloader
/lk              emmc    /dev/block/by-name/lk_a               flags=display="lk"
/lk2             emmc    /dev/block/by-name/lk_b               flags=display="lk2"

# Other Partition
/logo            emmc    /dev/block/by-name/logo               flags=backup=1;display="Logo";flashimg=1;slotselect
/seccfg          emmc    /dev/block/by-name/seccfg
/spmfw           emmc    /dev/block/by-name/spmfw              flags=slotselect
/gz              emmc    /dev/block/by-name/gz                 flags=slotselect       
/tee             emmc    /dev/block/by-name/tee                flags=slotselect
/otp             emmc    /dev/block/by-name/otp    
/dpm             emmc    /dev/block/by-name/dpm                flags=slotselect    
/expdb           emmc    /dev/block/by-name/expdb
/mcupm           emmc    /dev/block/by-name/mcupm              flags=slotselect  
/md1img          emmc    /dev/block/by-name/md1img             flags=slotselect  
/otp             emmc    /dev/block/by-name/otp
/para            emmc    /dev/block/by-name/para
/scp             emmc    /dev/block/by-name/scp                flags=slotselect  
/sspm            emmc    /dev/block/by-name/sspm               flags=slotselect  
/tkv             emmc    /dev/block/by-name/tkv                flags=slotselect  

# Dynamic Partitions ( A/B Slots ) Set To A For Flashing IMG
/product_image         auto      /dev/block/mapper/product                 flags=backup=1;display="Product Image";logical;slotselect
/system_image          auto      /dev/block/mapper/system                  flags=backup=1;display="System Image";logical;slotselect
/system_ext_image      auto      /dev/block/mapper/system_ext              flags=backup=1;display="System_ext Image";logical;slotselect
/vendor_image          auto      /dev/block/mapper/vendor                  flags=backup=1;display="Vendor Image";logical;slotselect

/product_image         emmc      /dev/block/mapper/product                 flags=display="Product Image";flashimg=1;logical;slotselect
/system_image          emmc      /dev/block/mapper/system                  flags=display="System Image";flashimg=1;logical;slotselect
/system_ext_image      emmc      /dev/block/mapper/system_ext              flags=display="System_ext Image";flashimg=1;logical;slotselect
/vendor_image          emmc      /dev/block/mapper/vendor                  flags=display="Vendor Image";flashimg=1;logical;slotselect

# Removable storage
/external_sd        auto      /dev/block/mmcblk0p1    /dev/block/mmcblk0   flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg		auto		/dev/block/sda1					/dev/block/sda		/dev/block/sdd1			flags=display="USB-OTG";storage;wipeingui;removable;backup=0
